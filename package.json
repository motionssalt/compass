{
  "name": "motionsalt-compass",
  "version": "1.0.0",
  "description": "Conversational AI task manager Telegram bot on Cloudflare Workers",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply motionsalt_compass --local",
    "migrate:remote": "wrangler d1 migrations apply motionsalt_compass --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250718.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.90.0"
  }
}
